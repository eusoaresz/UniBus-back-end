# Valores fictícios: substitua no arquivo .env local.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/unibus
JWT_SECRET=substitua-por-um-segredo-aleatorio
PORT=3000
NODE_ENV=development
MAILTRAP_USER=seu-usuario-smtp
MAILTRAP_PASS=sua-senha-smtp
SMTP_FROM=UniBus <no-reply@example.com>
# Arquivos privados locais; em produção exige volume persistente e controle de acesso.
COMPROVANTES_DIR=.private/comprovantes
FOTOS_DIR=.private/fotos
# Web Push: habilitar após configurar as três variáveis e integrar o service worker do site.
WEB_PUSH_ENABLED=false
WEB_PUSH_SUBJECT=mailto:contato@example.com
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Stripe: integração desativada por padrão; nunca usar credenciais reais em testes.
PAGAMENTOS_ATIVOS=false
STRIPE_AMBIENTE=teste
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
